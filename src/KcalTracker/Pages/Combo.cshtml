@page
@model ComboModel
@using KcalTracker
@using KcalTracker.Calculo
@{
    ViewData["Title"] = Model.Formulario ? (Model.Id == 0 ? "Nuevo combo" : "Editar combo") : "Combos";
    ViewData["Nav"] = "combos";
}

<div class="page-head">
    <div>
        <h1>@(Model.Formulario ? (Model.Id == 0 ? "Nuevo combo" : "Editar combo") : "Combos")</h1>
        <p class="lede">@(Model.Formulario
            ? "Las kcal salen de los alimentos actuales. Editar un alimento no cambia los días ya comidos, pero sí este combo la próxima vez que lo uses."
            : "Plantillas de varios alimentos para cargar de una vez en Hoy.")</p>
    </div>
    <div class="page-actions">
        @if (Model.Formulario)
        {
            <a class="btn-sec" asp-page="/Combo">← Combos</a>
        }
        else
        {
            <a class="btn-pri" asp-page="/Combo" asp-route-nuevo="true">+ Nuevo combo</a>
        }
    </div>
</div>
<div class="page-body">
@if (Model.Mensaje is not null) { <p class="ok">@Model.Mensaje</p> }
@if (Model.Error is not null) { <p class="error">@Model.Error</p> }

@if (!Model.Formulario)
{
    @if (Model.Lista.Count == 0)
    {
        <section class="bloque">
            <p class="muted" style="margin:0">No hay combos. Armá uno con alimentos de tu catálogo.</p>
            <div class="ajuste-cta">
                <a class="btn-pri" asp-page="/Combo" asp-route-nuevo="true">+ Nuevo combo</a>
                <a class="btn-sec" asp-page="/Alimentos">Ir a alimentos</a>
            </div>
        </section>
    }
    else
    {
        <div class="tabla-wrap">
            <table class="datos">
                <thead>
                    <tr>
                        <th>Combo</th>
                        <th>Tramo</th>
                        <th>Composición</th>
                        <th>kcal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model.Lista)
                {
                    <tr>
                        <td>@c.Nombre</td>
                        <td>@(c.Tipo ?? "—")</td>
                        <td>@c.Composicion</td>
                        <td class="num">@Redondeo.Kcal(c.Kcal)</td>
                        <td class="fila-acciones">
                            <a class="btn-sec" asp-page="/Combo" asp-route-id="@c.Id">Editar</a>
                            <form method="post" asp-page-handler="Borrar" class="inline">
                                <input type="hidden" name="Id" value="@c.Id" />
                                <button type="submit" class="btn-borrar">Borrar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
else
{
    @if (!string.IsNullOrEmpty(Model.Vuelta))
    {
        <p class="aviso">Al guardar volvés al día desde el que viniste.</p>
    }

    <form method="post" asp-page-handler="Guardar">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Vuelta" />
        <section class="bloque">
            <h2>Datos</h2>
            <div class="form-grid">
                <div>
                    <label>Nombre</label>
                    <input asp-for="Nombre" />
                </div>
                <div>
                    <label>Tipo de comida sugerido</label>
                    <select asp-for="TipoComidaId">
                        <option value="">Sin tipo</option>
                        @foreach (var t in Model.Tipos)
                        {
                            <option value="@t.Id">@t.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        </section>

        <section class="bloque">
            <h2>Alimentos · @Formato.Kcal(Model.KcalEstimadas) kcal</h2>
            @if (Model.AlimentoIds.Count == 0)
            {
                <p class="muted">Todavía no hay ítems.</p>
            }
            else
            {
                <div class="tabla-wrap">
                    <table class="datos">
                        <thead><tr><th>Alimento</th><th>Cantidad</th><th>kcal</th><th></th></tr></thead>
                        <tbody>
                        @for (var i = 0; i < Model.AlimentoIds.Count; i++)
                        {
                            var a = Model.Catalogo.FirstOrDefault(x => x.Id == Model.AlimentoIds[i]);
                            var cant = i < Model.Cantidades.Count ? Model.Cantidades[i] : 1;
                            <tr>
                                <td>
                                    <input type="hidden" name="AlimentoIds[@i]" value="@Model.AlimentoIds[i]" />
                                    @(a?.Nombre ?? "?")
                                </td>
                                <td><input name="Cantidades[@i]" type="number" step="0.1" value="@cant" class="corto" /></td>
                                <td class="num">@(a is null ? "—" : Formato.Kcal(a.Kcal * cant))</td>
                                <td class="fila-acciones">
                                    <button type="submit" formaction="@Url.Page("/Combo", "Quitar", new { i, vuelta = Model.Vuelta })" class="btn-borrar">Quitar</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            <div class="fila-busca" style="margin-top:0.85rem">
                <select asp-for="NuevoAlimentoId">
                    @foreach (var a in Model.Catalogo)
                    {
                        <option value="@a.Id">@a.Nombre · @Formato.Kcal(a.Kcal)</option>
                    }
                </select>
                <button type="submit" formaction="@Url.Page("/Combo", "Agregar", new { vuelta = Model.Vuelta })" class="btn-sec">Agregar</button>
            </div>
            <div class="ajuste-cta">
                <button type="submit" class="btn-pri">Guardar combo</button>
                @if (!string.IsNullOrEmpty(Model.Vuelta))
                {
                    <a class="btn-sec" href="@Model.Vuelta">Cancelar</a>
                }
                else
                {
                    <a class="btn-sec" asp-page="/Combo">Cancelar</a>
                }
            </div>
        </section>
    </form>

    @if (Model.Id != 0)
    {
        <section class="bloque ajuste-peligro">
            <h2>Desactivar</h2>
            <p class="ayuda">Los días ya comidos no se tocan. El combo deja de aparecer al cargar.</p>
            <form method="post" asp-page-handler="Borrar">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Vuelta" />
                <div class="ajuste-cta">
                    <button type="submit" class="btn-peligro">Desactivar combo</button>
                </div>
            </form>
        </section>
    }
}
</div>
