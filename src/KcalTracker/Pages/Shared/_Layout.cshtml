@using KcalTracker
@using KcalTracker.Dominio
@using KcalTracker.Servicios
@using Microsoft.AspNetCore.Antiforgery
@inject ServicioContexto Contexto
@inject IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="es-UY">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#dfe8e2" />
    <title>@(ViewData["Title"] is string t ? $"{t} · kcal-tracker" : "kcal-tracker")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/htmx.min.js" asp-append-version="true"></script>
</head>
@{
    var nav = ViewData["Nav"] as string;
    var alta = ViewData["Alta"] as bool? == true;
    var sesion = User.Identity?.IsAuthenticated == true;
    var conBarra = sesion && !alta;
    var lat = conBarra ? await Contexto.CargarAsync() : null;
    var enBiblio = nav is "alimentos" or "combos" or "rutinas" or "ejercicios" or "cardio" or "actividad";
}
<body class="@(conBarra ? "app" : "")"
      hx-headers='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string> { ["RequestVerificationToken"] = Antiforgery.GetAndStoreTokens(Context).RequestToken ?? "" }))'>
@if (conBarra)
{
    <aside>
        <a class="marca" asp-page="/Index">kcal<span class="tenue">-tracker</span></a>
        <nav>
            <div class="navgrupo">Diario</div>
            <ul>
                <li><a class="@(nav == "hoy" ? "on" : null)" asp-page="/Index">Hoy</a></li>
                <li><a class="@(nav == "dashboard" ? "on" : null)" asp-page="/Dashboard">Dashboard</a></li>
                <li><a class="@(nav == "objetivo" ? "on" : null)" asp-page="/Objetivo">Objetivo</a></li>
                <li><a class="@(nav == "mediciones" ? "on" : null)" asp-page="/Mediciones">Mediciones</a></li>
            </ul>
            <details class="nav-fold" @(enBiblio ? "open" : null)>
                <summary class="navgrupo">Biblioteca</summary>
                <ul>
                    <li><a class="@(nav == "alimentos" ? "on" : null)" asp-page="/Alimentos">Alimentos</a></li>
                    <li><a class="@(nav == "combos" ? "on" : null)" asp-page="/Combo">Combos</a></li>
                    <li><a class="@(nav == "rutinas" ? "on" : null)" asp-page="/Rutinas">Rutinas</a></li>
                    <li><a class="@(nav == "ejercicios" ? "on" : null)" asp-page="/Ejercicios">Ejercicios</a></li>
                    <li><a class="@(nav == "cardio" ? "on" : null)" asp-page="/Cardio">Cardio</a></li>
                    <li><a class="@(nav == "actividad" ? "on" : null)" asp-page="/Actividad">Actividades</a></li>
                </ul>
            </details>
        </nav>
    </aside>
    <div class="cuerpo">
        @if (lat is not null)
        {
            <header class="cuerpo-top">
                <details class="menu cuenta-menu">
                    <summary class="cuenta-btn" aria-label="Tu cuenta">
                        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="8" r="3.4"/>
                            <path d="M5.2 19.2c1.4-3.1 3.9-4.7 6.8-4.7s5.4 1.6 6.8 4.7"/>
                        </svg>
                    </summary>
                    <div class="menu-panel cuenta-panel">
                        <div class="who">@lat.Nombre</div>
                        <div class="mail">@lat.Email</div>
                        <dl>
                            <div class="fila-lat">
                                <dt>Última medición</dt>
                                <dd>
                                    @if (lat.Medicion is { } m)
                                    {
                                        <a class="peso" asp-page="/Mediciones">@m.PesoKg.ToString("0.#") kg @if (m.GrasaPct is { } g) { <text>· @g.ToString("0.#") %</text> }</a>
                                    }
                                    else
                                    {
                                        <a class="peso" asp-page="/Mediciones">Cargar</a>
                                    }
                                </dd>
                            </div>
                            <div class="fila-lat">
                                <dt>Objetivo</dt>
                                <dd>@TipoObjetivoNombres.De(lat.TipoObjetivo)@(lat.GrasaObjetivoPct is { } obj ? " · " + obj.ToString("0") + " %" : "")</dd>
                            </div>
                            <div class="fila-lat">
                                <dt>Falta perder</dt>
                                <dd>@(lat.TipoObjetivo == TipoObjetivo.GananciaMusculo ? "—" : lat.GrasaAPerderKg is double falta && falta > 0 ? "≈ " + Formato.Kg(falta, 1) + " kg de grasa" : "—")</dd>
                            </div>
                        </dl>
                        <div class="cuenta-links">
                            <a class="@(nav == "mediciones" ? "on" : null)" asp-page="/Mediciones">Mediciones</a>
                            <a class="@(nav == "ajustes" ? "on" : null)" asp-page="/Ajustes">Ajustes</a>
                            <form asp-page="/Salir" method="post">
                                <button type="submit" class="enlace-salir">Cerrar sesión</button>
                            </form>
                        </div>
                    </div>
                </details>
            </header>
        }
        <main>
            @RenderBody()
        </main>
    </div>
    <nav class="barra-mobile" aria-label="Principal">
        <a class="@(nav == "hoy" ? "on" : null)" asp-page="/Index">Hoy</a>
        <a class="@(nav == "dashboard" ? "on" : null)" asp-page="/Dashboard">Dashboard</a>
        <a class="@(nav == "objetivo" ? "on" : null)" asp-page="/Objetivo">Objetivo</a>
        <a class="@(nav == "mediciones" ? "on" : null)" asp-page="/Mediciones">Mediciones</a>
        <details class="mas-mobile">
            <summary>Más</summary>
            <div class="mas-panel">
                <a asp-page="/Alimentos">Alimentos</a>
                <a asp-page="/Combo">Combos</a>
                <a asp-page="/Rutinas">Rutinas</a>
                <a asp-page="/Ejercicios">Ejercicios</a>
                <a asp-page="/Cardio">Cardio</a>
                <a asp-page="/Actividad">Actividades</a>
            </div>
        </details>
    </nav>
}
else
{
    <header>
        <a class="marca" asp-page="/Index">kcal<span class="tenue">-tracker</span></a>
        @if (sesion)
        {
            <span class="sep">·</span>
            <form asp-page="/Salir" method="post" class="salir">
                <button type="submit" class="btn-ghost">Cerrar sesión</button>
            </form>
        }
    </header>
    <main>
        @RenderBody()
    </main>
}
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
